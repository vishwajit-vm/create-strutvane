{
  "name": "create-strutvane",
  "version": "0.2.0-next.2",
  "description": "Start a new Strutvane app in one command: npm create strutvane@latest my-app. Asks how you want it set up, then writes the project, generates secrets, picks ports, starts the database (your own server or Docker), installs, migrates, seeds and makes the first commit.",
  "keywords": [
    "strutvane",
    "create",
    "starter",
    "scaffolding",
    "installer",
    "typescript",
    "mvc",
    "b2b"
  ],
  "homepage": "https://github.com/vishwajit-vm/create-strutvane#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/create-strutvane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/create-strutvane.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "create-strutvane": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skeleton/LICENSE",
    "skeleton/skeleton.json",
    "skeleton/template",
    "skeleton/vendor.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "vendor:skeleton": "node scripts/vendor-skeleton.ts",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "strutvane": {
    "allowConsole": []
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  }
}
